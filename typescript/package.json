{
  "name": "zora-coins",
  "version": "0.1.1",
  "description": "Typed client for the Zora Coins API (all 30 endpoints), a GraphQL client, and an onchain indexer for Zora creator and referral rewards on Base. Zero dependencies; Node, Bun, Deno and browsers.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }, "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" } },
    "./rewards": { "import": { "types": "./dist/rewards/index.d.ts", "default": "./dist/rewards/index.js" }, "require": { "types": "./dist/rewards/index.d.cts", "default": "./dist/rewards/index.cjs" } }
  },
  "bin": { "zora-rewards": "./dist/cli.js" },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:live": "LIVE=1 vitest run test/live.test.ts",
    "typecheck": "tsc --noEmit",
    "docs": "typedoc src/index.ts src/rewards/index.ts --out docs"
  },
  "keywords": ["zora", "zora coins", "creator coins", "base", "web3", "sdk", "graphql"],
  "license": "MIT",
  "author": "Rebel Studios Software <contact@rebelstudiossoftware.com>",
  "repository": { "type": "git", "url": "git+https://github.com/pgalyen1987/zora-coins-sdks.git", "directory": "typescript" },
  "homepage": "https://github.com/pgalyen1987/zora-coins-sdks/tree/main/typescript#readme",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "typedoc": "^0.26.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
